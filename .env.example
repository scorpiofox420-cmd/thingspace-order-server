# ThingSpace Order Server — environment variables
# Copy this file to .env and fill in your real values.
# The server reads .env automatically via start.sh (or Docker Compose).

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thingspace_orders
DB_USER=postgres
DB_PASSWORD=postgres
# Extra JDBC params — set "?sslmode=require" on Render
DB_PARAMS=

# ---- HTTP port ----
PORT=8080

# ---- ThingSpace credentials (see WHERE_TO_GO.md) ----
THINGSPACE_OAUTH_CLIENT_ID=your_client_id
THINGSPACE_OAUTH_CLIENT_SECRET=your_client_secret
THINGSPACE_VZ_M2M_TOKEN=your_vz_m2m_token
THINGSPACE_ACCOUNT_NAME=your_account_name

# Comma-separated request UUIDs the poller should track
THINGSPACE_REQUEST_IDS=

# SDK environment: PRODUCTION or MOCK_SERVER_FOR_LIMITED_AVAILABILITY_SEE_QUICK_START
THINGSPACE_ENVIRONMENT=PRODUCTION

# Optional base-URL overrides (leave empty for SDK defaults)
THINGSPACE_BASE_URL=
THINGSPACE_CREDENTIAL_BASE_URL=

# Poll interval in milliseconds (default 5 minutes)
THINGSPACE_POLL_INTERVAL_MS=300000

# ---- CORS for the web dashboard ----
# Leave * for a personal dashboard; set to your Vercel URL for production
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*